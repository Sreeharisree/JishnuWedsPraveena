rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared settings (e.g. Drive Webhook URL so all guests can upload to the couple's folder)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'sreehari9011@gmail.com';
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
